// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DocumentTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents DocumentModel[]

  @@map("document_types")
}

model DocumentModel {
  id        String   @id @default(uuid())
  title     String
  content   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId Int?

  userId String
  user   UserModel @relation(fields: [userId], references: [id])

  folderId String?
  folder   FolderModel? @relation(fields: [folderId], references: [id])

  documentTypeId String?
  documentType   DocumentTypeModel? @relation(fields: [documentTypeId], references: [id])

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])

  attachments AttachmentModel[]

  @@map("documents")
}

model UserModel {
  id       String @id @default(uuid())
  username String @unique
  password String
  role     String

  empId        Int?     @unique
  empCode      String?
  firstNameLa  String?
  lastNameLa   String?
  firstNameEng String?
  lastNameEng  String?
  email        String?
  phone        String?
  status       String?
  gender       String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branchId Int?
  branch   BranchModel? @relation(fields: [branchId], references: [id])

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])

  divisionId Int?
  division   DivisionModel? @relation(fields: [divisionId], references: [id])

  officeId Int?
  office   OfficeModel? @relation(fields: [officeId], references: [id])

  unitId Int?
  unit   UnitModel? @relation(fields: [unitId], references: [id])

  documents DocumentModel[]

  @@map("users")
}

model AttachmentModel {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  documentId String
  createdAt  DateTime @default(now())

  document DocumentModel @relation(fields: [documentId], references: [id])

  @@map("attachments")
}

model FolderModel {
  id          String  @id @default(uuid())
  folderCode  String  @unique
  contentName String
  locationRef String?
  status      String  @default("A")

  documents DocumentModel[]

  shelfId String
  shelf   ShelfModel @relation(fields: [shelfId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("folders")
}

model BranchModel {
  id     Int     @id
  code   String?
  name   String
  status String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisions DivisionModel[]
  users     UserModel[]
  lockers   LockerModel[]

  @@map("branches")
}

model DepartmentModel {
  id        Int      @id
  code      String
  name      String
  phone     String?
  email     String?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     UserModel[]
  documents DocumentModel[]
  divisions DivisionModel[]
  lockers   LockerModel[]

  @@map("departments")
}

model DivisionModel {
  id        Int    @id
  code      String
  name      String
  shortName String
  status    String

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])

  branchId Int?
  branch   BranchModel? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   UserModel[]
  offices OfficeModel[]
  units   UnitModel[]

  @@map("divisions")
}

model OfficeModel {
  id     Int    @id
  code   String
  name   String
  status String

  divisionId Int?
  division   DivisionModel? @relation(fields: [divisionId], references: [id])

  users UserModel[]
  units UnitModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offices")
}

model UnitModel {
  id     Int    @id
  code   String
  name   String
  type   String
  status String

  officeId Int?
  office   OfficeModel? @relation(fields: [officeId], references: [id])

  divisionId Int?
  division   DivisionModel? @relation(fields: [divisionId], references: [id])

  users UserModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model LockerModel {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String?
  description String?
  status      String  @default("A")

  branchId     Int?
  branch       BranchModel?     @relation(fields: [branchId], references: [id])
  departmentId Int?
  deparment    DepartmentModel? @relation(fields: [departmentId], references: [id])

  shelves ShelfModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lockers")
}

model ShelfModel {
  id          String  @id @default(uuid())
  code        String
  description String?
  status      String  @default("A")

  lockerId String
  locker   LockerModel @relation(fields: [lockerId], references: [id])

  folders FolderModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shelves")
}

model AuditLogModel {
  id         String   @id @default(uuid())
  action     String
  details    String?
  entityId   String
  entityType String
  actorId    String
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
