// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserModel {
  id       String @id @default(uuid())
  password String
  role     String

  empId        Int?
  empCode      String?  @unique
  firstNameLa  String?
  lastNameLa   String?
  firstNameEng String?
  lastNameEng  String?
  email        String?  @unique
  phone        String?
  status       String?
  gender       String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])

  userDivisions UserDivisionModel[]

  officeId Int?
  office   OfficeModel? @relation(fields: [officeId], references: [id])

  unitId Int?
  unit   UnitModel? @relation(fields: [unitId], references: [id])

  documents       DocumentModel[]
  recordedBorrows DocumentBorrowModel[] @relation("RecordedBy")
  auditLogs       AuditLogModel[]       @relation("UserAuditLogs")

  @@map("users")
}

model AttachmentModel {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  documentId String
  createdAt  DateTime @default(now())

  document DocumentModel @relation(fields: [documentId], references: [id])

  @@map("attachments")
}

model DepartmentModel {
  id        Int      @id
  code      String
  name      String
  phone     String?
  email     String?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      UserModel[]
  divisions  DivisionModel[]
  offices    OfficeModel[]
  units      UnitModel[]
  documents  DocumentModel[]
  warehouses WarehouseModel[]
  auditLogs  AuditLogModel[]

  @@map("departments")
}

model DivisionModel {
  id        Int    @id
  code      String
  name      String
  shortName String
  status    String

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userDivisions   UserDivisionModel[]
  offices         OfficeModel[]
  units           UnitModel[]
  documentBorrows DocumentBorrowModel[]
  documents       DocumentModel[]
  warehouses      WarehouseModel[]
  auditLogs       AuditLogModel[]

  @@map("divisions")
}

model OfficeModel {
  id     Int    @id
  code   String
  name   String
  status String

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  divisionId   Int?
  division     DivisionModel?   @relation(fields: [divisionId], references: [id])

  users UserModel[]
  units UnitModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offices")
}

model UnitModel {
  id     Int    @id
  code   String
  name   String
  type   String
  status String

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  officeId     Int?
  office       OfficeModel?     @relation(fields: [officeId], references: [id])
  divisionId   Int?
  division     DivisionModel?   @relation(fields: [divisionId], references: [id])

  users UserModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model WarehouseModel {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  status      String  @default("A")

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])
  divisionId   Int?
  division     DivisionModel?   @relation(fields: [divisionId], references: [id])

  lockers LockerModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

model LockerModel {
  id          String  @id @default(uuid())
  code        String
  name        String?
  description String?
  status      String  @default("A")

  warehouseId String?
  warehouse   WarehouseModel? @relation(fields: [warehouseId], references: [id])

  shelves ShelfModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@map("lockers")
}

model ShelfModel {
  id          String  @id @default(uuid())
  name        String
  description String?
  status      String  @default("A")
  maxQty      Int

  lockerId String
  locker   LockerModel @relation(fields: [lockerId], references: [id])

  folders FolderModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shelves")
}

model FolderModel {
  id          String  @id @default(uuid())
  code        String
  name        String
  status      String  @default("A")
  qrCode      String
  locationRef String?
  description String

  shelfId String
  shelf   ShelfModel @relation(fields: [shelfId], references: [id])

  documents   DocumentModel[]
  borrowItems DocumentBorrowItemModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shelfId, code])
  @@map("folders")
}

model DocumentTypeModel {
  id          String   @id @default(uuid())
  code        String?
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents DocumentModel[]

  @@map("document_types")
}

model DocumentModel {
  id                      String   @id @default(uuid())
  docNo                   String
  shortName               String?
  docDate                 DateTime
  title                   String
  description             String?
  docExpire               DateTime
  qrCode                  String
  isContractBound         Boolean  @default(false)
  destructionApprovalPath String?

  userId String
  user   UserModel @relation(fields: [userId], references: [id])

  folderId String?
  folder   FolderModel? @relation(fields: [folderId], references: [id])

  documentTypeId String?
  documentType   DocumentTypeModel? @relation(fields: [documentTypeId], references: [id])

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id])

  divisionId Int?
  division   DivisionModel? @relation(fields: [divisionId], references: [id])

  attachments  AttachmentModel[]
  borrowItems  DocumentBorrowItemModel[]
  subDocuments SubDocumentModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model SubDocumentModel {
  id         String   @id @default(uuid())
  subDocNo   String
  subDocDate DateTime

  documentId String
  document   DocumentModel @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, subDocNo])
  @@map("sub_documents")
}

model AuditLogModel {
  id         String   @id @default(uuid())
  action     String
  details    String?
  status     String?

  entityType String?
  entityId   String?

  actorId String?
  actor   UserModel? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  departmentId Int?
  department   DepartmentModel? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  divisionId Int?
  division   DivisionModel? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?
  method    String?
  path      String?

  oldValue Json?
  newValue Json?
  payload  Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([departmentId])
  @@index([divisionId])
  @@map("audit_logs")
}

model DocumentBorrowModel {
  id String @id @default(uuid())

  // ຄົນທີ່ຢືມ
  borrower String
  phone    String? // ເບີໂທ

  borrowedAt DateTime  @default(now()) // ວັນທີ/ເວລາຢືມ
  dueDate    DateTime? // ກຳນົດສົ່ງ

  purpose String? // ຈຸດປະສົງ

  // ພາກສ່ວນໃດ
  toDivisionId Int?
  toDivision   DivisionModel? @relation(fields: [toDivisionId], references: [id])
  toLocation   String? // free text ເສີມ (ຫ້ອງ, ຊັ້ນ, ...)
  // ຄົນທີ່ບັນທຶກ
  createdById  String
  createdBy    UserModel      @relation("RecordedBy", fields: [createdById], references: [id])

  note String?

  status String @default("BORROWED") // ສະຖານະ (e.g. BORROWED, PARTIALLY_RETURNED, RETURNED)

  items DocumentBorrowItemModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_borrows")
}

model DocumentBorrowItemModel {
  id String @id @default(uuid())

  borrowId String
  borrow   DocumentBorrowModel @relation(fields: [borrowId], references: [id], onDelete: Cascade)

  documentId String?
  document   DocumentModel? @relation(fields: [documentId], references: [id])

  folderId String?
  folder   FolderModel? @relation(fields: [folderId], references: [id])

  returnedAt DateTime? // null = ຍັງບໍ່ຄືນ
  status     String    @default("BORROWED") // ສະຖານະ (e.g. BORROWED, RETURNED)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_borrow_items")
}

model UserDivisionModel {
  id         String        @id @default(uuid())
  userId     String
  user       UserModel     @relation(fields: [userId], references: [id])
  divisionId Int
  division   DivisionModel @relation(fields: [divisionId], references: [id])
  isPrimary  Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@unique([userId, divisionId])
  @@map("user_divisions")
}
